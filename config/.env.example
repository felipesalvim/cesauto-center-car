# Copie para .env e ajuste. Nunca versionar o arquivo .env.
# Caminho: config/.env (fora de /public)

APP_ENV=local
APP_URL=http://localhost/bk-autos/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bk_autos
DB_USER=root
DB_PASS=

# Rate limit do formulário (requisições por minuto, por IP)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60

# WhatsApp / telefone (DDI+DDD+número, só dígitos) — Cesauto Center Car
WHATSAPP_NUMBER=5585986191000
